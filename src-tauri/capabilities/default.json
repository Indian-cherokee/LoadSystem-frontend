{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "cors-fetch:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://192.168.0.0/16" },
        { "url": "http://172.16.0.0/12" },
        { "url": "http://10.0.0.0/8" },
        { "url": "http://localhost" }
      ],
      "deny": []
    },
    "http:allow-fetch",
    "http:allow-fetch-read-body",
    "http:allow-fetch-send"
  ]
}

